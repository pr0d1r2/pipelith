amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

local all = (generated.steps) { ...generated.push }

hooks {
  // Check, never fix (nix B4, V55): with stash = "none" a fix rewrote
  // files the commit then left unstaged, so commits landed with their own
  // gate red. A finding refuses the commit; run `hk fix` and restage.
  ["pre-commit"] {
    fix = false
    stash = "none"
    steps = (generated.steps) {
      // nix T28, V42: work lands by branch and pull request, never on main.
      // HERE, not in .pklith: it is a rule about making a commit, which
      // happens only through this hook. pre-push, `hk check`, CI and the
      // release hook all run on main by design, so there the step could
      // only fail; it refused `cargo release hook` and the v0.2.0 tag push.
      // As actlith.
      ["no-commit-to-branch"] {
        check = "bash nix/guard/no-commit-to-branch.sh main"
      }
    }
  }
  // nix T21, dev V41: subject `type(scope): claim`, at most 72 characters,
  // a body that says why; tested Rust in pipelith-dev. hk passes the file
  // git gave the hook (MERGE_MSG on a merge).
  ["commit-msg"] {
    steps {
      ["commit-msg"] {
        check = "cargo run -q -p pipelith-dev -- commit-msg {{commit_msg_file}}"
      }
      // SPEC.md V7, nix C: a feat, fix or perf commit changing src/ adds a
      // CHANGELOG entry. Here, not in pre-commit: only the message says
      // which kind a change is.
      ["changelog-touched"] {
        check = "cargo run -q -p pipelith-dev -- changelog {{commit_msg_file}}"
        // After commit-msg, never beside it: two cargo runs at once contend
        // for the target directory lock.
        depends = List("commit-msg")
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    stage = true
    fix = true
    steps = all
  }
}
